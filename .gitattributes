# Normalise line endings on checkin: the repo is authored on Windows but may be
# cloned on Linux (CI, Render, Docker).
* text=auto eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Windows-only helper scripts keep CRLF.
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary assets must never be touched.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.db   binary
