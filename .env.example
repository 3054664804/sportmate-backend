# Reference for the environment variables this service understands.
#
# IMPORTANT: this project does NOT auto-load a .env file (no python-dotenv
# dependency). Set these as real environment variables, e.g.
#   PowerShell :  $env:SPORTMATE_DATABASE_URL = "sqlite:///./data/sportmate.db"
#   bash       :  export SPORTMATE_DATABASE_URL="sqlite:///./data/sportmate.db"
#   Render     :  Dashboard -> Environment -> Add Environment Variable
#
# Every value is optional. With nothing set, config.py uses an absolute SQLite
# path inside the project (data/sportmate.db), which needs no configuration.

# Storage backend.
#   SQLite, relative to the current working directory:
#       SPORTMATE_DATABASE_URL=sqlite:///./data/sportmate.db
#   SQLite, absolute path (note the FOUR slashes):
#       SPORTMATE_DATABASE_URL=sqlite:////var/data/sportmate.db
#   PostgreSQL (e.g. Render / Supabase):
#       SPORTMATE_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/sportmate
SPORTMATE_DATABASE_URL=sqlite:///./data/sportmate.db

# Login token lifetime in days.
SPORTMATE_TOKEN_TTL_DAYS=30
